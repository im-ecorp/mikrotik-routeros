# The image tag to pull. Only ever set this to a version that is already
# published; the Dockerfile's ARG ROUTEROS_VERSION is the seed the *next* build
# will use, and the two move at different times. 7.21.5 goes here once it ships.
ROUTEROS_VERSION=7.21.4

# Compatibility default: management TCP ports listen on every host IPv4 address.
# Recommended for new setups: set 127.0.0.1 BEFORE first boot, then use an SSH
# tunnel through the Docker host. Remote direct access will no longer work.
# See docs/networking.md. VPN and custom mappings are NOT restricted by this.
MANAGEMENT_BIND_IP=0.0.0.0
